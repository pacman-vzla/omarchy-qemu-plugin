#!/bin/bash
# Switch the widget language. Applies live and survives plugin updates.
STATE="$HOME/.local/state/dix.qemu"

case "$1" in
  es|en)
    mkdir -p "$STATE"
    printf '%s\n' "$1" > "$STATE/lang"
    echo "Language set to $1"
    ;;
  *)
    echo "Usage: set-language [en|es]"
    exit 1
    ;;
esac
